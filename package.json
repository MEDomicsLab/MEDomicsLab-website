{
  "name": "vance-lab-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:strict": "vite build --logLevel info",
    "build:analyze": "vite-bundle-visualizer -o dist/stats.html",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "lint:knip": "knip",
    "lint:images": "node .github/scripts/check-unused-assets.mjs",
    "lint:avatars": "node .github/scripts/check-avatar-variants.mjs",
    "lint:licenses": "node .github/scripts/check-licenses.mjs",
    "lint:schemas": "node .github/scripts/check-schemas.mjs",
    "test:scripts": "node --test .github/scripts/__tests__/*.test.mjs",
    "check:issue-content": "npm run lint:md && npm run lint:images && npm run lint:avatars && npm run lint:schemas && npm run test:scripts",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "test:e2e": "playwright test",
    "test:seo": "playwright test e2e/seo.spec.js",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:a11y": "playwright test e2e/a11y.spec.js",
    "lhci": "lhci autorun --config=.github/lighthouserc.json",
    "size": "size-limit",
    "check": "npm run lint && npm run format:check && npm run lint:md && npm run lint:knip && npm run lint:images && npm run lint:avatars && npm run lint:licenses && npm run lint:schemas && npm run test:scripts",
    "check:full": "npm run check && npm run build && npm run size && npm run test:e2e"
  },
  "size-limit": [
    {
      "name": "JS bundle",
      "path": "dist/assets/*.js",
      "limit": "1500 KB"
    },
    {
      "name": "CSS bundle",
      "path": "dist/assets/*.css",
      "limit": "100 KB"
    }
  ],
  "dependencies": {
    "@mux/mux-player-react": "^3.10.2",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-menubar": "^1.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@use-gesture/react": "^10.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.27.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.166.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^9.18.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.3",
    "@vitejs/plugin-react": "^4.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "knip": "^6.6.2",
    "license-checker-rseidelsohn": "^4.4.2",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.4.2",
    "sharp": "^0.34.5",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.0.3",
    "tw-animate-css": "^1.2.0",
    "vite": "^5.4.2",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-sitemap": "^0.8.2"
  }
}
