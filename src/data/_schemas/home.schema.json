{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "home.schema.json",
  "title": "Home Page Content",
  "type": "object",
  "required": ["hero", "brand", "mission", "sections"],
  "properties": {
    "hero": { "type": "object" },
    "brand": { "type": "object" },
    "mission": { "type": "object" },
    "sections": {
      "type": "object",
      "required": ["focusAreas", "recentOutput", "openSource"],
      "properties": {
        "focusAreas": { "type": "object" },
        "recentOutput": { "type": "object" },
        "openSource": {
          "type": "object",
          "required": ["title", "viewAll", "repositories"],
          "properties": {
            "title": { "type": "string" },
            "viewAll": { "type": "string" },
            "repositories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "description", "status", "url"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "description": { "type": "string", "minLength": 1 },
                  "status": { "type": "string", "minLength": 1 },
                  "url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        }
      }
    }
  }
}
