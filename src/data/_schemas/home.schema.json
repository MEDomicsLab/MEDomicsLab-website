{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "home.schema.json",
  "title": "Home Page Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["hero", "brand", "mission", "sections"],
  "properties": {
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoUrl"],
      "properties": {
        "videoUrl": { "type": "string", "format": "uri" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "siteUrl", "repositoryUrl", "logoUrl", "lightLogoUrl"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "siteUrl": { "type": "string", "format": "uri" },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "logoUrl": { "type": "string" },
        "lightLogoUrl": { "type": "string" }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": { "text": { "type": "string" } }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem"],
      "properties": {
        "ecosystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apps"],
          "properties": {
            "apps": {
              "type": "array",
              "description": "Shared projects for the homepage ecosystem and navbar GitHub menu.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "repo", "logo"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "website": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public website. When absent, the homepage diagram and the navbar GitHub menu link the repository instead."
                  },
                  "repo": {
                    "type": "string",
                    "format": "uri"
                  },
                  "logo": {
                    "type": "string",
                    "description": "Public logo image path."
                  },
                  "statsSnapshot": {
                    "type": "object",
                    "description": "Stars/forks shown when the live GitHub API is unavailable (rate limit, offline). Refresh occasionally.",
                    "required": ["stars", "forks"],
                    "additionalProperties": false,
                    "properties": {
                      "stars": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "forks": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
