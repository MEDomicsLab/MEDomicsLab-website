{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "team.schema.json",
  "title": "Team",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["year", "members"],
    "additionalProperties": false,
    "properties": {
      "year": { "type": "string", "minLength": 1 },
      "members": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "position", "slug", "image"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "position": { "type": "string", "minLength": 1 },
            "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "email": { "type": "string" },
            "image": { "type": "string", "minLength": 1 },
            "bio": { "type": "string" },
            "note": { "type": "string" },
            "expertise": {
              "type": "array",
              "items": { "type": "string" }
            },
            "education": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["course", "institution", "year"],
                "additionalProperties": false,
                "properties": {
                  "course": { "type": "string" },
                  "institution": { "type": "string" },
                  "year": { "type": "string" }
                }
              }
            },
            "socials": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "linkedin": { "type": "string" },
                "orcid": { "type": "string" },
                "scholar": { "type": "string" },
                "researchgate": { "type": "string" },
                "github": { "type": "string" },
                "stackoverflow": { "type": "string" },
                "cv": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
