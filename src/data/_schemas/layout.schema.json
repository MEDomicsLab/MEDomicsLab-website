{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "layout.schema.json",
  "title": "Layout",
  "type": "object",
  "required": ["navItems", "footer"],
  "properties": {
    "navItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["labelKey", "defaultLabel"],
        "properties": {
          "path": { "type": "string" },
          "labelKey": { "type": "string" },
          "defaultLabel": { "type": "string" },
          "label": { "type": "string" },
          "rollingText": { "type": "array", "items": { "type": "string" } },
          "rollingSuffix": { "type": "string" },
          "children": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    },
    "footer": { "type": "object" }
  }
}
