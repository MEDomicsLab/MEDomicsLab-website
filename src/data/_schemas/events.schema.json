{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "events.schema.json",
  "title": "Events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["year", "months"],
    "additionalProperties": false,
    "properties": {
      "year": {
        "type": "string",
        "pattern": "^[0-9]{4}$"
      },
      "months": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["month", "items"],
          "additionalProperties": false,
          "properties": {
            "month": {
              "type": "string",
              "description": "English month name; the site and the issue automation both order months chronologically.",
              "enum": [
                "January",
                "February",
                "March",
                "April",
                "May",
                "June",
                "July",
                "August",
                "September",
                "October",
                "November",
                "December"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "slug", "category", "contributors"],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "category": {
                    "type": "string",
                    "description": "Drives the Events page filter. Mirrors the event-kind dropdown of the Add an event issue form.",
                    "enum": [
                      "Presentations",
                      "Thesis Defenses",
                      "Symposiums",
                      "Workshops",
                      "Seminars",
                      "Lab Life",
                      "Outreach",
                      "Other"
                    ]
                  },
                  "date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "description": "ISO start date; orders items within a month.",
                    "format": "date"
                  },
                  "contributors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "markdown": {
                    "type": "string"
                  },
                  "coverImage": {
                    "type": "object",
                    "required": ["url"],
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "alt": {
                        "type": "string"
                      }
                    }
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "venue": {
                    "type": "string",
                    "minLength": 1
                  },
                  "endDate": {
                    "type": "string",
                    "format": "date",
                    "description": "Optional inclusive end date for a multi-day event."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
