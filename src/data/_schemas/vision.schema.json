{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research vision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "headline",
    "researchQuestionLead",
    "researchQuestion",
    "overview",
    "premises",
    "longTermVision",
    "domains",
    "approach",
    "progressMilestone",
    "integration",
    "scopeTitle",
    "axesTitle",
    "axes",
    "ecosystem",
    "gapsTitle",
    "gaps",
    "work",
    "figures",
    "publications"
  ],
  "properties": {
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "researchQuestionLead": {
      "type": "string",
      "minLength": 1
    },
    "researchQuestion": {
      "type": "string",
      "minLength": 1
    },
    "overview": {
      "description": "The opening argument: the first paragraph is set as the section's lede.",
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "premises": {
      "description": "Rendered as one heading, `title` followed by `scope`, above the premises.",
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "scope", "items"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "longTermVision": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "model", "details"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "approach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lead", "description"],
      "properties": {
        "lead": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "progressMilestone": {
      "type": "string",
      "minLength": 1
    },
    "integration": {
      "type": "string",
      "minLength": 1
    },
    "scopeTitle": {
      "type": "string",
      "minLength": 1
    },
    "axesTitle": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "paragraphs"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ecosystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lead", "apps"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "apps": {
          "description": "Cards shown in the ring, in the order of the research statement. `name` matches an app in home.json.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "alt"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "description": "Visible caption when it differs from the application name.",
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "gapsTitle": {
      "type": "string",
      "minLength": 1
    },
    "gaps": {
      "type": "string",
      "minLength": 1
    },
    "work": {
      "type": "string",
      "minLength": 1
    },
    "figures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "cycle", "scope"],
      "properties": {
        "program": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "caption"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "cycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "caption"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "caption"],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "caption": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "publications": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(JA|CP)[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    }
  }
}
